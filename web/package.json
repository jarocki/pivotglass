    "test:usability": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-reading-preferences.test.ts scripts/test-guidance-navigation.test.ts scripts/test-overlay-focus.test.ts scripts/test-intake-review.test.ts scripts/test-document-intake.test.ts",
